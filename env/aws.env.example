# Future AWS. Same code path: unset S3_ENDPOINT_URL so boto3 hits real S3;
# point DATABASE_URL at RDS. Nothing else changes.
DATABASE_URL=postgresql+psycopg://USER:PASS@your-instance.rds.amazonaws.com:5432/adc
ARTIFACT_STORAGE_BACKEND=aws_s3
# S3_ENDPOINT_URL intentionally unset -> real AWS S3
S3_BUCKET=adc-pipeline-runs
S3_REGION=us-east-1
# credentials via IAM role / standard AWS credential chain
