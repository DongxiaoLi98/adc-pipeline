# Supabase Local: Postgres + file-backed Storage. Simplest, zero extra containers.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_LOCAL_ROOT=storage        # 字节落在这里（已 gitignore）
ARTIFACT_BASE_URI=local://runs     # artifacts.storage_uri 的前缀
